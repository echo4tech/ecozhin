APP_ENV=development
APP_DEBUG=true
# Sub-folder the app is served from. Leave commented to auto-detect (XAMPP: /ecozhin). Use APP_BASE= for the web root.
# APP_BASE=/ecozhin

# XAMPP defaults (user root, empty password). On a real server use a dedicated low-privilege user.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=circular_economy
DB_USERNAME=root
DB_PASSWORD=

AI_PROVIDER=
AI_API_KEY=

MAP_PROVIDER=
MAP_API_KEY=
